{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "emailtasker-auth",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "emailtasker-auth.azzuwayed.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": false,
  },
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
  },
}
