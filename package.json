{
  "name": "emailtasker-website",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "check": "pnpm check:format && pnpm check:site",
    "check:format": "prettier --check \"*.html\" \"*.js\" \"ar/*.html\" \"*.md\" \"*.json\" \"scripts/*.mjs\" \"style.css\"",
    "check:site": "node scripts/check-site.mjs",
    "format": "prettier --write \"*.html\" \"*.js\" \"ar/*.html\" \"*.md\" \"*.json\" \"scripts/*.mjs\" \"style.css\"",
    "format:release": "prettier --write CHANGELOG.md updates.json"
  },
  "devDependencies": {
    "prettier": "3.8.4"
  }
}
